<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Connection dot + title; the status text itself lives in the ⋮ menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/connDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot"
                    android:backgroundTint="@color/text_muted" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Shown only while not connected (connecting / disconnected / reconnecting) -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_connecting"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/voiceButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voice_input"
            android:src="@drawable/ic_mic"
            android:tint="@color/keybar_text" />

        <ImageButton
            android:id="@+id/pasteImageButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/paste_image"
            android:src="@drawable/ic_image"
            android:tint="@color/keybar_text" />

        <ImageButton
            android:id="@+id/fitButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fit_screen"
            android:src="@drawable/ic_fit_screen"
            android:tint="@color/keybar_text" />

        <ImageButton
            android:id="@+id/keyboardButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/keyboard"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/keybar_text" />

        <ImageButton
            android:id="@+id/filesButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/files_title"
            android:src="@drawable/ic_folder_open"
            android:tint="@color/keybar_text" />

        <!-- Options: info (connection, sizes), view settings (font) -->
        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/terminal_options"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/keybar_text" />
    </LinearLayout>

    <!-- Pinch = gallery-style zoom of the picture, one finger drags it while zoomed (ZoomPanLayout). -->
    <com.neststudio.pocketshell.ui.ZoomPanLayout
        android:id="@+id/zoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <com.termux.view.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </com.neststudio.pocketshell.ui.ZoomPanLayout>

    <!-- Quick replies while the AI CLI waits on a numbered question (built in TerminalActivity.showQuickReplies) -->
    <LinearLayout
        android:id="@+id/quickBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_keybar"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_keybar"
        android:fadingEdgeLength="24dp"
        android:fillViewport="true"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <!-- Keycaps (bg_keycap), built in TerminalActivity.buildKeyBar -->
        <LinearLayout
            android:id="@+id/keyBar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>
</LinearLayout>
