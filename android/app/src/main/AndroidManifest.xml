<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-update install (DESIGN.md §11.4) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- LAN discovery broadcast replies (DESIGN.md §12.2) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- "An AI CLI stopped" notifications (DESIGN.md §14): a foreground service long-polls each paired PC. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".PkshellApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Pkshell">

        <!-- Stays the launcher component so existing home-screen icons keep working; it hands off to the PC list. -->
        <activity
            android:name=".ui.SessionListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PcListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PairingActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- pocketshell://pair?h=…&p=…&pin=…&fp=… (a shared session's link): the form is filled in, the user starts it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pocketshell" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- QR scanner (zxing-android-embedded): follow the phone's rotation instead of its fixed landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <activity
            android:name=".ui.GitChangesActivity"
            android:exported="false" />

        <!-- Home screen / app icon shortcuts to a project folder: opens the session there (see ShortcutActivity). -->
        <activity
            android:name=".ui.ShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Pkshell.Translucent" />

        <activity
            android:name=".ui.TerminalActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Pkshell.Terminal"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <activity
            android:name=".ui.TerminalTextActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.FileBrowserActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FileViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.WebActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Serves downloaded update APKs (cache/updates/) to the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- No push server sits between phone and PC, so the phone itself waits on the PCs it is paired with. -->
        <service
            android:name=".notify.AgentWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for the user's own PCs on the LAN / VPN to report that a terminal session needs attention" />
        </service>

        <receiver
            android:name=".notify.AgentReplyReceiver"
            android:exported="false" />

        <!-- "Share → PocketShell" from other apps: text or an image goes to a session the user picks. -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@style/Theme.Pkshell.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: AI session counts of the paired PCs. -->
        <receiver
            android:name=".notify.AgentWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agents_info" />
        </receiver>

        <!-- Quick settings tile: the same counts, lit while an AI waits on a question. -->
        <service
            android:name=".notify.AgentTileService"
            android:exported="true"
            android:icon="@drawable/ic_notify"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
