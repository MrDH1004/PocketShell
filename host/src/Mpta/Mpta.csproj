<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>psh</AssemblyName>
    <ApplicationIcon>..\..\..\assets\pocketshell.ico</ApplicationIcon>
    <Product>PocketShell</Product>
    <RootNamespace>Mpta</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Clipboard image for the phone's Alt+V paste (Server/ClipboardImage.cs). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the implicit usings (names like Timer/Application would clash). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mpta.Core\Mpta.Core.csproj" />
  </ItemGroup>
</Project>
