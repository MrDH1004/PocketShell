<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>psh</AssemblyName>
    <ApplicationIcon>..\..\..\assets\pocketshell.ico</ApplicationIcon>
    <Product>PocketShell</Product>
    <RootNamespace>Pkshell</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Clipboard image for the phone's Alt+V paste (Server/ClipboardImage.cs). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UI Automation (System.Windows.Automation) for Windows Terminal tab names (Server/TerminalTabs.cs). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the implicit usings (names like Timer/Application would clash). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- UseWPF drops these from the implicit usings. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pkshell.Core\Pkshell.Core.csproj" />
  </ItemGroup>
</Project>
